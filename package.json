{
  "name": "ai-product-owner-agent",
  "displayName": "AI Product Owner Agent",
  "description": "Professional VS Code extension for automated technical analysis of Jira epics and universal codebase analysis across 9 programming languages with GitHub Copilot integration",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "jira",
    "analysis",
    "documentation",
    "copilot",
    "product-owner",
    "technical-writing",
    "automation",
    "codebase-analysis"
  ],
  "publisher": "ai-product-owner-team",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srinidhi94/Product-Owner-AI-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/Srinidhi94/Product-Owner-AI-Agent/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiProductOwner.analyzeEpic",
        "title": "Analyze Epic",
        "category": "AI Product Owner",
        "icon": "$(graph)",
        "enablement": "aiProductOwner.configured",
        "description": "Analyze a Jira epic and universal codebase across 9 programming languages to generate technical documentation."
      },
      {
        "command": "aiProductOwner.configureSettings",
        "title": "Configure Settings",
        "category": "AI Product Owner",
        "icon": "$(settings-gear)",
        "description": "Configure Jira and extension settings."
      },

      {
        "command": "aiProductOwner.openWalkthrough",
        "title": "Show Welcome Walkthrough",
        "category": "AI Product Owner",
        "icon": "$(lightbulb)",
        "description": "Show the welcome walkthrough for new users."
      },
      {
        "command": "aiProductOwner.testConnection",
        "title": "Test Jira Connection",
        "category": "AI Product Owner",
        "icon": "$(plug)",
        "description": "Test the connection to your Jira instance."
      },
      {
        "command": "aiProductOwner.completeStage",
        "title": "Complete Current Stage & Continue",
        "category": "AI Product Owner",
        "icon": "$(arrow-right)",
        "description": "Mark current analysis stage as complete and proceed to next stage."
      },
      {
        "command": "aiProductOwner.cancelAnalysis",
        "title": "Cancel Analysis",
        "category": "AI Product Owner",
        "icon": "$(stop)",
        "description": "Cancel the current analysis workflow."
      }
    ],
    "configuration": {
      "title": "AI Product Owner Agent",
      "properties": {
        "aiProductOwner.jira.baseUrl": {
          "type": "string",
          "description": "Jira base URL (e.g., company.atlassian.net)",
          "scope": "application",
          "order": 1,
          "category": "JIRA Integration"
        },
        "aiProductOwner.jira.email": {
          "type": "string",
          "description": "Your Jira email address",
          "scope": "application",
          "order": 2,
          "category": "JIRA Integration"
        },
        "aiProductOwner.jira.token": {
          "type": "string",
          "description": "Jira API token (stored securely in VS Code secrets)",
          "scope": "application",
          "order": 3,
          "category": "JIRA Integration"
        },
        "aiProductOwner.jira.timeout": {
          "type": "number",
          "default": 10000,
          "minimum": 5000,
          "maximum": 30000,
          "description": "Jira API request timeout in milliseconds",
          "scope": "application",
          "order": 4,
          "category": "JIRA Integration"
        },
        "aiProductOwner.output.directory": {
          "type": "string",
          "default": "./ai-analysis",
          "description": "Base output directory for generated documentation. Each Jira epic will create a subfolder here (e.g., ./ai-analysis/PROJ-123/)",
          "scope": "workspace",
          "order": 5,
          "category": "Output Settings"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiProductOwner",
          "title": "AI Product Owner",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "aiProductOwner": [
        {
          "id": "analysisResults",
          "name": "Analysis Results",
          "when": "aiProductOwner.hasResults",
          "icon": "$(graph)"
        },
        {
          "id": "currentAnalysis",
          "name": "Current Analysis",
          "when": "aiProductOwner.analyzing",
          "icon": "$(loading~spin)"
        },
        {
          "id": "quickActions",
          "name": "Quick Actions",
          "when": "aiProductOwner.configured",
          "icon": "$(zap)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiProductOwner.analyzeEpic",
          "when": "aiProductOwner.configured"
        },
        {
          "command": "aiProductOwner.refreshDocumentation",
          "when": "aiProductOwner.hasResults"
        }
      ],
      "view/title": [
        {
          "command": "aiProductOwner.analyzeEpic",
          "when": "view == analysisResults",
          "group": "navigation"
        },
        {
          "command": "aiProductOwner.refreshDocumentation",
          "when": "view == analysisResults",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiProductOwner.analyzeEpic",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "aiProductOwner.configured"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts --fix",
    "lint:check": "eslint src --ext ts",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:integration": "echo 'Integration tests require VS Code environment - run via Extension Host or CI'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "package-extension": "./scripts/package.sh",
    "vsce-package": "vsce package --no-dependencies",
    "vsce-publish": "vsce publish --no-dependencies",
    "clean": "rm -rf out && rm -rf *.vsix && rm -rf node_modules/.cache && rm -rf .tsbuildinfo && rm -rf coverage",
    "clean:all": "npm run clean && rm -rf node_modules",
    "build": "npm run clean && npm run compile",
    "build:prod": "npm run clean && npm run package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "validate": "npm run typecheck && npm run lint:check && npm run format:check",
    "release": "npm run validate && npm run test:coverage && npm run build:prod && npm run vsce-package",
    "release:quick": "npm run test && npm run build:prod && npm run vsce-package",
    "dev": "npm run watch",
    "start": "npm run compile && code --extensionDevelopmentPath=.",
    "debug": "npm run compile && code --extensionDevelopmentPath=. --verbose"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "glob": "^8.0.3",
    "mocha": "^10.8.2",
    "prettier": "^2.8.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "@jest/globals": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "mermaid": "^10.6.0",
    "yaml": "^2.3.4"
  }
}
