{
  "root": true,
  "env": {
    "browser": false,
    "es6": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "node_modules",
    "**/*.d.ts",
    "*.vsix",
    ".vscode",
    "webpack.config.js"
  ]
}
